# PUBLIC-SAFE TEMPLATE — do not put real secrets here.
# Configure these in Vercel > Project > Settings > Environment Variables.
# Recommended type in Vercel: Secret.
ADMIN_PASSWORD=replace-with-a-long-unique-admin-password
PRO_PASSWORD=replace-with-main-pro-password
PRO_PASSWORD_1=replace-with-pro-password-1
PRO_PASSWORD_2=replace-with-pro-password-2
PRO_PASSWORD_3=replace-with-pro-password-3
PRO_PASSWORD_4=replace-with-pro-password-4
PRO_PASSWORD_5=replace-with-pro-password-5
PRO_PASSWORD_6=replace-with-pro-password-6
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
